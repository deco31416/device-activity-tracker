# Port Configuration
# Backend server port
BACKEND_PORT=4000

# Client (frontend) port
CLIENT_PORT=4001

# Backend URL (used by the frontend)
BACKEND_URL=http://127.0.0.1:4000

# Public backend URL used to build Authorized Check-In links.
# Set this to your HTTPS backend URL on Railway/VPS/reverse proxy.
# Required for external Open Graph previews; localhost/127.0.0.1 only works on this machine.
PUBLIC_BASE_URL=http://127.0.0.1:4000

# Comma-separated frontend origins allowed by the backend.
# Defaults include localhost/127.0.0.1 ports 3000, 3001, 4000, and 4001.
# Recommended local frontend origin for this project:
# ALLOWED_ORIGINS=http://127.0.0.1:4001,http://localhost:4001

# MongoDB Configuration
# Connection URI for MongoDB (local or Atlas)
MONGODB_URI=mongodb://localhost:27017
# Database name
MONGODB_DB=device-tracker

# Node Environment
# Use development locally. In production, DASHBOARD_TOKEN is required and must be strong.
NODE_ENV=development

# Runtime mode
# local-full enables packet capture on this machine.
# railway-dashboard disables local capture and keeps dashboard/statistics features.
DEPLOYMENT_MODE=local-full
LOCAL_CAPTURE_ENABLED=true

# Optional locally, required in NODE_ENV=production.
# Must be at least 32 characters in production. REST API and Socket.IO require this token.
# DASHBOARD_TOKEN=

# Proxy trust for client IP detection.
# Local default: false. Railway default: 1 trusted proxy hop.
# TRUST_PROXY=false

# Public Authorized Check-In submit rate limit (in-memory fallback).
# CHECKIN_SUBMIT_RATE_WINDOW_MS=600000
# CHECKIN_SUBMIT_RATE_MAX_PER_IP=60
# CHECKIN_SUBMIT_RATE_MAX_PER_TOKEN_IP=8

# API documentation.
# Swagger is only served when this is true AND NODE_ENV is not production.
ENABLE_SWAGGER=false

# Optional IP enrichment for call-analysis candidates.
# Uses DB-IP as primary GeoIP provider by default, with ip-api as technical complement/fallback.
# DB-IP free returns strong country/region/city hints; paid DB-IP keys can return extended fields.
# ip-api complements coordinates, ISP, org, ASN, mobile/proxy/hosting, and Google Maps URL when needed.
ENABLE_IP_ENRICHMENT=true
IP_ENRICHMENT_PRIMARY_PROVIDER=db-ip
DB_IP_API_KEY=free
IP_ENRICHMENT_CACHE_TTL_SEC=604800
IP_ENRICHMENT_TIMEOUT_MS=3500

# Optional: only used if automatic call capture is enabled by backend events.
# Manual capture from the UI requires these values per capture instead.
# DEFAULT_CASE_ID=
# DEFAULT_OPERATOR_NAME=
# DEFAULT_AUTHORIZATION_NOTE=
