# Port Configuration
# Backend server port
BACKEND_PORT=3001

# Client (frontend) port
CLIENT_PORT=3000

# Backend URL (used by the frontend)
BACKEND_URL=http://localhost:3001

# MongoDB Configuration
# Connection URI for MongoDB (local or Atlas)
MONGODB_URI=mongodb://localhost:27017
# Database name
MONGODB_DB=device-tracker

# Node Environment
NODE_ENV=production

# Runtime mode
# local-full enables packet capture on this machine.
# railway-dashboard disables local capture and keeps dashboard/statistics features.
DEPLOYMENT_MODE=local-full
LOCAL_CAPTURE_ENABLED=true

# Optional locally, strongly recommended for Railway/public domains.
# When set, REST API and Socket.IO require this token.
# DASHBOARD_TOKEN=

# API documentation.
# Swagger is only served when this is true AND NODE_ENV is not production.
ENABLE_SWAGGER=false

# Optional: only used if automatic call capture is enabled by backend events.
# Manual capture from the UI requires these values per capture instead.
# DEFAULT_CASE_ID=
# DEFAULT_OPERATOR_NAME=
# DEFAULT_AUTHORIZATION_NOTE=
