{
  "name": "@deco31416/device-activity-tracker",
  "version": "2.9.4",
  "type": "module",
  "description": "WhatsApp activity tracker with RTT analysis, real-time bitácora, contact history, report generation, and network monitoring",
  "main": "dist/index.js",
  "keywords": [
    "whatsapp",
    "privacy",
    "security",
    "research",
    "tracking",
    "rtt",
    "device-activity",
    "mongodb",
